---
import { Image } from 'astro:assets';
import heroBg from '../assets/hero_bg.webp';
import { ArrowRight } from "@lucide/astro";
---

<section class="relative min-h-screen flex items-center overflow-hidden">
  <!-- Background image ottimizzata con Astro -->
  <div class="absolute inset-0 -z-10">
    <Image 
      src={heroBg} 
      alt="Sfondo della sezione principale dello studio di psicologia" 
      class="w-full h-full object-cover"
      loading="eager"
      quality="high"
    />
    <!-- Overlay per garantire la leggibilità del testo -->
    <div class="absolute inset-0 bg-slate-900/40"></div>
  </div>

  <div class="w-full max-w-screen-2xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 pt-24 pb-16">
    <div class="max-w-4xl">
      
      <!-- Eyebrow -->
      <div class="flex items-center gap-3 mb-6">
        <!-- Sostituite le parentesi quadre con le classi native -->
        <span class="block w-8 h-px bg-sage-light"></span>
        <span class="font-ui text-xs tracking-widest uppercase text-sage-light">
          Psicologa · Psicoterapeuta · Roma &amp; Online
        </span>
      </div>

      <!-- Heading -->
      <h1 class="font-display text-5xl md:text-6xl lg:text-7xl font-light leading-tight text-white mb-6">
        Ciao,{" "}
        <em class="italic text-sage-light">
          come stai?
        </em>
      </h1>

      <p class="font-body text-lg md:text-xl text-white/85 leading-relaxed mb-10 max-w-2xl">
        Quante volte rispondiamo in automatico “Bene, grazie… e tu?” 
        Eppure è una domanda tutt'altro che banale. Rispondere significa aprire una finestra sul proprio mondo interno, e quando la risposta è difficile, un aiuto professionale può trasformare gli ostacoli in possibilità di crescita.
      </p>

      <div class="flex flex-col sm:flex-row gap-4">
        <a
          href="#contatti"
          class="btn-press font-ui font-medium px-8 py-4 rounded-full text-white text-sm tracking-wide transition-all duration-200 hover:opacity-90 flex items-center gap-2 justify-center bg-sage"
        >
          Prenota un colloquio
          <ArrowRight size={16} />
        </a>
        <a
          href="#servizi"
          class="btn-press font-ui font-medium px-8 py-4 rounded-full text-white text-sm tracking-wide border border-white/40 hover:bg-white/10 transition-all duration-200"
        >
          Scopri i servizi
        </a>
      </div>
    </div>
  </div>
</section>