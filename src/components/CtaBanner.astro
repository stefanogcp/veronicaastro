---
import { Phone, ArrowRight } from "@lucide/astro";
---

<section
      class="py-20 md:py-28"
      style={{ backgroundColor: "var(--color-sage)" }}
    >
      <div class="w-full max-w-screen-2xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="fade-up text-center max-w-2xl mx-auto">
          <h2
            class="font-display text-4xl md:text-5xl text-white leading-tight mb-6"
            style={{ fontWeight: 300 }}
          >
            Desideri avere{" "}
            <em class="italic">maggiori informazioni?</em>
          </h2>
          <p class="font-body text-white/85 text-lg mb-10">
            Vuoi prenotare un primo colloquio conoscitivo o essere informato
            sulle prossime attività? Sono qui per aiutarti.
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a
              href="#contatti"
              class="btn-press font-ui font-medium px-8 py-4 rounded-full text-sm tracking-wide bg-white transition-all duration-200 hover:bg-white/90 flex items-center gap-2 justify-center"
              style={{ color: "var(--color-sage-dark)" }}
            >
              Contattami ora
              <ArrowRight size={15} />
            </a>
            <a
              href="tel:3297220788"
              class="btn-press font-ui font-medium px-8 py-4 rounded-full text-sm tracking-wide border-2 border-white/60 text-white hover:bg-white/10 transition-all duration-200 flex items-center gap-2 justify-center"
            >
              <Phone size={15} />
              329 7220788
            </a>
          </div>
        </div>
      </div>
    </section>