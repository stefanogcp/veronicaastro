---
import { Brain, Heart, Sparkles, ArrowRight } from "@lucide/astro";

const SERVICE_CONSULTATION = "/images/service.webp";
const SERVICE_WELLNESS = "/images/wellness.webp";

const services = [
  {
    icon: Brain,
    title: "Consulenza Psicologica",
    subtitle: "Individuale, di coppia e online",
    description:
      "Un aiuto professionale per affrontare momenti di difficoltà personale, superare crisi, gestire eventi critici e promuovere il benessere psicofisico. Utile per disturbi d'ansia, dell'umore, difficoltà relazionali e di coppia.",
    image: SERVICE_CONSULTATION,
    tags: ["Individuale", "Di coppia", "Online"],
    href: "/servizi/consulenza-psicologica",
  },
  {
    icon: Heart,
    title: "Benessere Psicofisico",
    subtitle: "Mente e corpo in equilibrio",
    description:
      "Sviluppare risorse personali in un'ottica integrata mente-corpo. Ti senti stressato o sovraccaricato? Impara a gestire lo stress e migliora la qualità della vita attraverso un percorso personalizzato.",
    image: SERVICE_WELLNESS,
    tags: ["Gestione stress", "Mindfulness", "Psicosomatica"],
    href: "/servizi/benessere-psicofisico",
  },
  {
    icon: Sparkles,
    title: "Programma AttivaMente",
    subtitle: "Allenamento cognitivo",
    description:
      "Hai problemi di memoria e concentrazione? Vuoi prevenire gli effetti dell'invecchiamento mentale? Allena la mente e mantienila attiva più a lungo attraverso esercizi mirati e scientificamente validati.",
    image: null,
    tags: ["Memoria", "Concentrazione", "Prevenzione"],
    href: "/servizi/attivamente",
  },
];
---

<section id="servizi" class="py-20 md:py-32 bg-cream">
  <div class="w-full max-w-screen-2xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="fade-up mb-14 md:mb-20">
      <span
        class="font-ui text-xs tracking-widest uppercase mb-4 block text-sage"
      >
        I miei servizi
      </span>
      <h2
        class="font-display text-4xl md:text-5xl leading-tight max-w-xl text-slate-deep font-light"
      >
        Servizi per la salute e il <em class="italic">benessere psicofisico</em>
      </h2>
      <span class="section-divider"></span>
    </div>

    <div class="grid md:grid-cols-3 gap-8">
      {
        services.map((s, i) => {
          const Icon = s.icon;
          return (
            <a
              href={s.href}
              class="flex flex-col h-full fade-up group bg-white rounded-2xl overflow-hidden border border-border shadow-[0_1px_4px_rgba(0,0,0,0.06)] transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_12px_40px_rgba(122,158,126,0.18)] hover:border-sage"
              data-delay={i * 100}
            >
              {s.image ? (
                <div class="h-48 overflow-hidden shrink-0">
                  <img
                    src={s.image}
                    alt={s.title}
                    class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                  />
                </div>
              ) : (
                <div class="h-48 flex items-center justify-center bg-sage-light shrink-0">
                  <Icon size={56} class="text-sage-dark" stroke-width={1} />
                </div>
              )}

              <div class="p-6 flex flex-col flex-grow">
                <div class="flex items-center gap-3 mb-3">
                  <div class="w-8 h-8 rounded-full flex items-center justify-center flex-shrink-0 bg-sage-light">
                    <Icon size={16} class="text-sage-dark" />
                  </div>

                  <div>
                    <h3 class="font-display text-xl leading-tight text-slate-deep font-medium">
                      {s.title}
                    </h3>
                  </div>
                </div>

                <p class="font-ui text-xs tracking-widest uppercase mb-3 text-sage">
                  {s.subtitle}
                </p>

                <p class="font-body text-sm leading-relaxed mb-4 text-muted-foreground">
                  {s.description}
                </p>

                <div class="mt-auto flex items-end w-full pt-4">
                  <div class="flex flex-wrap gap-2 pr-4">
                    {s.tags.map((tag) => (
                      <span class="font-ui text-xs px-3 py-1 rounded-full bg-sage-light text-sage-dark">
                        {tag}
                      </span>
                    ))}
                  </div>

                  <div class="ml-auto w-8 h-8 flex-shrink-0 rounded-full flex items-center justify-center bg-sage-light text-sage-dark transition-all duration-300 opacity-100 translate-x-0 md:opacity-0 md:-translate-x-3 group-hover:opacity-100 group-hover:translate-x-0">
                    <ArrowRight size={16} />
                  </div>
                </div>
              </div>
            </a>
          );
        })
      }
    </div>
  </div>
</section>
