---
import "../styles/global.css";
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "Sito Psicologa", 
  description = "Psicologa e Psicoterapeuta a Roma e online. Percorsi di consulenza psicologica, psicoterapia individuale e di coppia per il tuo benessere." 
} = Astro.props;
---

<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&family=DM+Sans:wght@400;500;700&family=Lato:wght@300;400;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body class="w-full min-h-screen m-0 p-0 bg-white antialiased text-slate-800">
    <Navbar />
    <slot />
    <Footer />
  </body>
</html>
